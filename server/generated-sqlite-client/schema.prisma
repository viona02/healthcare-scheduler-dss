generator client {
  provider = "prisma-client-js"
  output   = "../generated-sqlite-client"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  fullName  String
  role      String   @default("worker")
  workerId  Int?     @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Worker {
  id                Int      @id @default(autoincrement())
  name              String
  workerType        String
  skillLevel        String
  isActive          Boolean  @default(true)
  fixedShift        String?
  weekendHolidayOff Boolean  @default(false)
  sundayHolidayOff  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
}

model Shift {
  id          Int      @id @default(autoincrement())
  name        String
  startTime   String
  endTime     String
  durationHrs Float
  minNurses   Int
  minMidwives Int
  minSeniors  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model Schedule {
  id              Int      @id @default(autoincrement())
  month           Int
  year            Int
  status          String?  @default("draft")
  isSelected      Boolean  @default(false)
  fitnessScore    Float
  generationCount Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
}

model Assignment {
  id         Int      @id @default(autoincrement())
  scheduleId Int
  workerId   Int
  dayOfMonth Int
  shiftId    Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
}

model ShiftRequest {
  id              Int       @id @default(autoincrement())
  workerId        Int
  date            DateTime
  endDate         DateTime?
  type            String
  shiftPref       String?
  reason          String?
  status          String    @default("pending")
  rejectionReason String?
}
