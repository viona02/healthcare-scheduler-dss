generator client {
  provider      = "prisma-client-js"
  output        = "../generated-sqlite-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  fullName  String
  role      String   @default("worker")
  workerId  Int?     @unique
  worker    Worker?  @relation(fields: [workerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Worker {
  id                Int            @id @default(autoincrement())
  name              String
  workerType        String
  skillLevel        String
  isActive          Boolean        @default(true)
  fixedShift        String?
  weekendHolidayOff Boolean        @default(false)
  sundayHolidayOff  Boolean        @default(false)
  user              User?
  assignments       Assignment[]
  shiftRequests     ShiftRequest[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Shift {
  id          Int          @id @default(autoincrement())
  name        String
  startTime   String
  endTime     String
  durationHrs Float
  minNurses   Int
  minMidwives Int
  minSeniors  Int
  assignments Assignment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Schedule {
  id              Int          @id @default(autoincrement())
  month           Int
  year            Int
  status          String?
  isSelected      Boolean      @default(false)
  fitnessScore    Float
  generationCount Int
  assignments     Assignment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Assignment {
  id         Int      @id @default(autoincrement())
  scheduleId Int
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  workerId   Int
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  dayOfMonth Int
  shiftId    Int
  shift      Shift    @relation(fields: [shiftId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scheduleId, workerId, dayOfMonth])
}

model ShiftRequest {
  id              Int       @id @default(autoincrement())
  workerId        Int
  worker          Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date            DateTime
  endDate         DateTime?
  type            String
  shiftPref       String?
  reason          String?
  status          String    @default("pending")
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
