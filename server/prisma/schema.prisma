// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User - untuk login (Admin & Tenaga Kerja)
// ============================================
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  fullName  String
  role      String   @default("worker") // "admin" | "worker"
  workerId  Int?     @unique
  worker    Worker?  @relation(fields: [workerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// Worker - Data Tenaga Kerja Kesehatan
// ============================================
model Worker {
  id                 Int          @id @default(autoincrement())
  name               String
  workerType         String       // "perawat" | "bidan"
  skillLevel         String       // "junior" | "senior"
  isActive           Boolean      @default(true)
  fixedShift         String?      // shift yang dipaksa, mis. "Pagi". null = tidak ada aturan khusus
  weekendHolidayOff  Boolean      @default(false) // wajib libur setiap weekend (Sabtu & Minggu) & tanggal merah
  sundayHolidayOff   Boolean      @default(false) // wajib libur setiap Minggu & tanggal merah
  user               User?
  assignments        Assignment[]
  shiftRequests      ShiftRequest[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

// ============================================
// Shift - Definisi Shift Kerja
// ============================================
model Shift {
  id           Int          @id @default(autoincrement())
  name         String       // "Pagi" | "Siang" | "Malam"
  startTime    String       // "07:00"
  endTime      String       // "14:00"
  durationHrs  Float        // 7.0
  minNurses    Int          // Minimal perawat (mis. 2)
  minMidwives  Int          // Minimal bidan (mis. 1)
  minSeniors   Int          // Minimal senior (mis. 1)
  assignments  Assignment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ============================================
// Schedule - Master Hasil Jadwal Ter-generate
// ============================================
model Schedule {
  id              Int          @id @default(autoincrement())
  month           Int          // 1 - 12
  year            Int          // 2026
  status          String       @default("draft") // "draft" | "published"
  isSelected      Boolean      @default(false)   // Jadwal aktif pilihan admin
  fitnessScore    Float
  generationCount Int
  assignments     Assignment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ============================================
// Assignment - Detail Penugasan Shift per Hari
// ============================================
model Assignment {
  id         Int      @id @default(autoincrement())
  scheduleId Int
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  workerId   Int
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  dayOfMonth Int      // 1 - 31 (atau 1 - 30 untuk periode)
  shiftId    Int
  shift      Shift    @relation(fields: [shiftId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scheduleId, workerId, dayOfMonth])
}

// ============================================
// ShiftRequest - Permintaan Libur / Shift Nakes
// ============================================
model ShiftRequest {
  id              Int       @id @default(autoincrement())
  workerId        Int
  worker          Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date            DateTime  // Tanggal mulai
  endDate         DateTime? // Tanggal selesai (null jika 1 hari saja)
  type            String    // "off" | "preference"
  shiftPref       String?   // "Pagi" | "Siang" | "Malam" (jika type = preference)
  reason          String?   // Alasan opsional
  status          String    @default("pending") // "pending" | "approved" | "rejected"
  rejectionReason String?   // Alasan penolakan dari admin
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
